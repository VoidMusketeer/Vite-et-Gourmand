@startuml
title Vite et Gourmand — Cas d'utilisation
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
actor Visiteur
actor "Client connecté" as Client
actor "Employé connecté" as Employe
actor "Administrateur connecté" as Admin
Admin --|> Employe
rectangle "Vite et Gourmand" {
  usecase "Consulter et filtrer les menus" as Consulter
  usecase "Consulter les plats et allergènes" as Details
  usecase "Créer un compte" as Inscription
  usecase "Se connecter" as Connexion
  usecase "Gérer le panier" as Panier
  usecase "Passer une commande" as Commander
  usecase "Suivre ses commandes" as Suivi
  usecase "Modifier ou annuler sa\ncommande en attente" as Modifier
  usecase "Déposer un avis sur une\ncommande terminée" as Avis
  usecase "Gérer ses coordonnées\net son mot de passe" as Profil
  usecase "Gérer les commandes\net leur progression" as Commandes
  usecase "Suivre le prêt et\nle retour du matériel" as Materiel
  usecase "Consulter le planning" as Planning
  usecase "Gérer les menus et les plats" as Catalogue
  usecase "Gérer les horaires d'ouverture" as Horaires
  usecase "Modérer les avis" as Moderation
  usecase "Créer et gérer les\ncomptes employés" as Equipe
  usecase "Consulter les statistiques" as Statistiques
  usecase "Sélectionner les\ncontenus de l'accueil" as Accueil
}
Visiteur -- Consulter
Visiteur -- Details
Visiteur -- Inscription
Visiteur -- Connexion
Visiteur -- Panier
Client -- Commander
Client -- Suivi
Client -- Modifier
Client -- Avis
Client -- Profil
Employe -- Profil
Employe -- Commandes
Employe -- Materiel
Employe -- Planning
Employe -- Catalogue
Employe -- Horaires
Employe -- Moderation
Admin -- Equipe
Admin -- Statistiques
Admin -- Accueil
note bottom of Consulter
  Les fonctions publiques restent accessibles
  aux utilisateurs connectés.
end note
note bottom of Commander
  Précondition : client authentifié.
  Réservation sans débit bancaire.
end note
@enduml
