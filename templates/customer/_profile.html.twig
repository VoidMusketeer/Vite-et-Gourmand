<h2 class="customer-section-title">Paramètres du compte</h2>
<div class="customer-settings">
    {% set fields = {
    name: {label: 'Nom complet', icon: 'person', value: profile.first_name ~ ' ' ~ profile.last_name},
    email: {label: 'E-mail', icon: 'envelope', value: profile.email},
    phone: {label: 'Téléphone', icon: 'telephone', value: profile.phone},
    address: {label: 'Adresse', icon: 'geo-alt', value: profile.address ~ ', ' ~ profile.postal_code ~ ' ' ~ profile.city},
    password: {label: 'Mot de passe', icon: 'lock', value: '••••••••'}
} %}
    {% for field, data in fields %}
        <div class="customer-setting">
            <i class="bi bi-{{ data.icon }}" aria-hidden="true"></i>
            <div><h3>{{ data.label }}</h3><p>{{ data.value }}</p></div>
            <button type="button" class="customer-button" data-action="customer-account#open" data-dialog="profile-{{ field }}" aria-label="Modifier : {{ data.label }}">Modifier</button>
        </div>
        <dialog id="profile-{{ field }}" class="customer-dialog" aria-labelledby="profile-title-{{ field }}" data-action="click->customer-account#backdrop">
            <button type="button" class="customer-close" aria-label="Fermer" data-action="customer-account#close">×</button>
            <h2 id="profile-title-{{ field }}">Modifier : {{ data.label }}</h2>
            <form method="post" action="{{ demo ? '#' : path('customer_profile_save') }}" data-action="submit->customer-account#submit" data-turbo="false">
                {% if not demo %}<input type="hidden" name="_token" value="{{ csrf_token('customer_profile') }}">{% endif %}
                <input type="hidden" name="field" value="{{ field }}">
                {% if field == 'name' %}
                    <label>Prénom<input name="first_name" autocomplete="given-name" value="{{ profile.first_name }}" maxlength="100" required></label>
                    <label>Nom<input name="last_name" autocomplete="family-name" value="{{ profile.last_name }}" maxlength="100" required></label>
                {% elseif field == 'email' %}
                    <label>E-mail<input name="email" type="email" autocomplete="email" value="{{ profile.email }}" maxlength="180" required></label>
                {% elseif field == 'phone' %}
                    <label>Téléphone<input name="phone" type="tel" autocomplete="tel" value="{{ profile.phone }}" maxlength="30" pattern="[+0-9 ().\-]{6,30}" required></label>
                {% elseif field == 'address' %}
                    <label>Adresse<input name="address" autocomplete="address-line1" value="{{ profile.address }}" maxlength="255" required></label>
                    <label>Code postal<input name="postal_code" autocomplete="postal-code" value="{{ profile.postal_code }}" maxlength="20" required></label>
                    <label>Ville<input name="city" autocomplete="address-level2" value="{{ profile.city }}" maxlength="120" required></label>
                {% endif %}
                {% if field in ['email', 'password'] %}<label>Mot de passe actuel<input name="current_password" type="password" autocomplete="current-password" required></label>{% endif %}
                {% if field == 'password' %}
                    <label>Nouveau mot de passe<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required></label><small>Au moins 12 caractères.</small>
                    <label>Confirmer le mot de passe<input name="confirmation" type="password" autocomplete="new-password" minlength="12" maxlength="72" required></label>
                {% endif %}
                {% if demo %}<p class="customer-muted">Démonstration : ces paramètres ne seront pas enregistrés.</p>{% endif %}
                <div class="customer-dialog-actions"><button type="button" class="customer-button" data-action="customer-account#close">Annuler</button><button class="customer-button primary">Enregistrer</button></div>
            </form>
        </dialog>
    {% endfor %}
</div>
{% if demo %}<p class="customer-settings-note">Démonstration : ces paramètres ne sont pas enregistrés et la modification du mot de passe reste un aperçu.</p>{% endif %}
