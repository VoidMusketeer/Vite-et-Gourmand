{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié ? — Vite & Gourmand{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/forgot-password.css') }}">
{% endblock %}
{% block body %}
<main class="forgot-password-page">
    <h1>Mot de passe oublié ?</h1>
    <p class="forgot-password-intro">Indiquez l'adresse e-mail de votre compte : un lien de réinitialisation vous sera envoyé.</p>
    <p class="forgot-password-notice" id="forgot-password-notice">Mode démonstration : les données affichées sont des exemples et rien n'est enregistré.</p>
    <form class="forgot-password-card" method="post" action="{{ path('app_forgot_password') }}" data-turbo="false" aria-describedby="forgot-password-notice">
        {% if submitted %}
            <p class="forgot-password-result" role="status">Démonstration : votre demande a été simulée. Aucun e-mail n'a été envoyé.</p>
        {% endif %}
        <label for="reset-email">Adresse e-mail</label>
        <input id="reset-email" name="email" type="email" autocomplete="email" placeholder="email@exemple.fr" value="{{ email }}" required{% if error %} aria-invalid="true" aria-describedby="reset-error"{% endif %}>
        {% if error %}<p id="reset-error" role="alert">{{ error }}</p>{% endif %}
        <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
        <button type="submit">Recevoir le lien</button>
    </form>
    <a class="forgot-password-back" href="{{ path('app_login') }}">Retour à la connexion</a>
</main>
{% endblock %}
