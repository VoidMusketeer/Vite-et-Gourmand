{% extends 'base.html.twig' %}
{% block title %}Mon panier · Vite & Gourmand{% endblock %}
{% block body %}
    <main class="basket-page">
        <a class="basket-back" href="{{ path('app_menus') }}">← Continuer ma sélection</a>
        <div class="basket-heading">
            <div><p class="basket-eyebrow">Votre réception</p><h1>Mon panier</h1></div>
            {% if items %}
                <form method="post" action="{{ path('app_basket_action') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('basket') }}">
                    <button class="basket-link" name="action" value="clear">Vider le panier</button>
                </form>
            {% endif %}
        </div>
        {% for message in app.flashes('basket_error') %}<p class="basket-notice" role="alert">{{ message }}</p>{% endfor %}
        {% if app.session.get('basket_undo') %}
            <div class="basket-notice" role="status">
                <span>Sélection supprimée.</span>
                <form method="post" action="{{ path('app_basket_action') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('basket') }}">
                    <button class="basket-link" name="action" value="undo">Annuler la suppression</button>
                </form>
            </div>
        {% endif %}
        {% if items %}
            <div class="basket-layout">
                <div class="basket-items">
                    {% for id, item in items %}
                        <article class="basket-card">
                            <div class="basket-product">
                                {% if item.image %}<img src="{{ asset(item.image) }}" alt="{{ item.name }}">{% endif %}
                                <div><h2><a href="{{ path('app_menu_detail', {id: id}) }}">{{ item.name }}</a></h2>
                                    <p>{{ item.base_price|number_format(2, ',', ' ') }} € / personne</p><small>Retrait / livraison</small>
                                </div>
                                <form method="post" action="{{ path('app_basket_item', {id: id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('basket') }}">
                                    <button class="basket-link" name="action" value="remove" aria-label="Retirer {{ item.name }} du panier">Retirer</button>
                                </form>
                            </div>
                            <form method="post" action="{{ path('app_basket_item', {id: id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('basket') }}">
                                <input type="hidden" name="date_format" value="fr">
                                <div class="basket-fields">
                                    <label>Date souhaitée <span class="basket-muted">(JJ/MM/AAAA)</span>
                                        <input name="date" type="text" inputmode="numeric" placeholder="JJ/MM/AAAA" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" required value="{{ item.date ? item.date|date('d/m/Y') : '' }}" aria-describedby="conditions-{{ id }}">
                                    </label>
                                    <label>Nombre de personnes<input type="number" name="guests" min="{{ item.min }}" max="9999" value="{{ item.guests }}" required></label>
                                </div>
                                <p class="basket-muted" id="conditions-{{ id }}">Minimum {{ item.min }} personnes · Préparation {{ item.hours }} h à l'avance.<br>À partir du {{ item.earliest|date('d/m/Y') }}{% if item.last_date %}, jusqu'au {{ item.last_date|date('d/m/Y') }}{% endif %}.{% if item.start %} Saison : {{ item.start|slice(3, 2) }}/{{ item.start|slice(0, 2) }} au {{ item.end|slice(3, 2) }}/{{ item.end|slice(0, 2) }}.{% endif %}</p>
                                {% if item.options %}<fieldset><legend>Options</legend>
                                        {% for option in item.options %}
                                            <label class="basket-option"><input type="checkbox" name="options[]" value="{{ option.name }}" {% if option.name in item.selected %}checked{% endif %}><span>{{ option.name }}</span><span class="basket-muted">{{ option.price ? '+' ~ option.price|number_format(2, ',', ' ') ~ ' € / pers.' : 'Inclus' }}</span></label>
                                        {% endfor %}
                                    </fieldset>{% endif %}
                                <button class="basket-secondary" type="submit">Enregistrer les modifications</button>
                            </form>
                            <div class="basket-subtotal"><span>Sous-total enregistré</span><strong>{{ item.subtotal|number_format(2, ',', ' ') }} €</strong></div>
                        </article>
                    {% endfor %}
                </div>
                <aside class="basket-summary" aria-labelledby="basket-summary-title">
                    <h2 id="basket-summary-title">Récapitulatif</h2>
                    <p>{{ items|length }} menu{{ items|length > 1 ? 's' : '' }} sélectionné{{ items|length > 1 ? 's' : '' }}</p>
                    <div class="basket-subtotal"><span>Total estimé</span><strong>{{ total|number_format(2, ',', ' ') }} €</strong></div>
                    <p class="basket-muted">Hors livraison. Disponibilités à confirmer avec Julie et José.</p>
                    <p>Aucun paiement à cette étape.</p>
                    <a class="basket-primary" href="{{ path('app_checkout') }}">Continuer ma demande de devis</a>
                    <p class="basket-muted basket-demo">Étape suivante en démonstration : aucune demande ne sera envoyée.</p>
                    <a class="basket-secondary" href="{{ path('app_contact') }}">Contacter Julie et José</a>
                    <p class="basket-muted basket-saved">Votre sélection enregistrée est conservée pendant votre session, même après actualisation.</p>
                </aside>
            </div>
        {% else %}
            <section class="basket-empty" aria-labelledby="empty-title">
                <svg width="68" height="68" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 26h50M12 26l6 28h28l6-28M20 26l9-18m15 18L35 8M25 28l2 24m12-24-2 24M17 40h30"/></svg>
                <h2 id="empty-title">Votre panier est encore vide</h2>
                <p>Un repas en famille ou une grande occasion ? Trouvons votre menu.</p>
                <a class="basket-primary" href="{{ path('app_menus') }}">Découvrir les menus</a>
            </section>
        {% endif %}
    </main>
{% endblock %}
