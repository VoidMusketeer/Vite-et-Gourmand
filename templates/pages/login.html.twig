{% extends 'base.html.twig' %}
{% block title %}Connexion — Vite & Gourmand{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}
{% block body %}
    <main class="login-page" data-controller="login-demo" data-admin-demo-url="{{ path('app_admin_demo') }}" data-customer-demo-url="{{ path('customer_demo') }}">
        <header>
            <span>Bienvenue</span>
            <h1>Connectez-vous à votre compte</h1>
            <p>Retrouvez vos commandes et leur suivi.</p>
        </header>
        <form class="login-card" method="post" action="{{ path('app_login') }}" data-turbo="false">
            {% for message in app.flashes('registration_success') %}<p class="login-notice" role="status">{{ message }}</p>{% endfor %}
            {% if error %}<p role="alert">Connexion impossible. Vérifiez votre adresse et votre mot de passe.</p>{% endif %}
            <label for="account-email">Adresse e-mail</label>
            <input id="account-email" name="_username" type="email" autocomplete="username" placeholder="email@exemple.fr" required>
            <label for="account-password">Mot de passe</label>
            <div class="login-password">
                <input id="account-password" name="_password" type="password" autocomplete="current-password" placeholder="Votre mot de passe" required>
                <button type="button" class="login-password-toggle" aria-controls="account-password" aria-label="Afficher le mot de passe" aria-pressed="false" data-action="login-demo#togglePassword"><i class="bi bi-eye" aria-hidden="true"></i></button>
            </div>
            <input name="_csrf_token" type="hidden" value="{{ csrf_token('login_account') }}">
            <button class="login-button">Se connecter</button>
            <a class="login-forgot" href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
            <section class="login-registration" aria-labelledby="login-registration-title">
                <h2 id="login-registration-title">Pas encore de compte ?</h2>
                <p>Créez le vôtre en quelques secondes pour suivre vos demandes.</p>
                <a class="login-button login-create-account" href="{{ path('app_register') }}">Créer mon compte</a>
            </section>
        </form>
        <details class="login-demo"><summary>Essayer la démonstration</summary>
            <p>Démo : un e-mail commençant par « admin » ouvre l’espace administrateur, « employe » l’espace employé, tout autre e-mail l’espace client.</p>
            <form class="login-card" method="get" data-action="submit->login-demo#preview">
                <label for="login-email">Adresse e-mail</label>
                <input id="login-email" type="email" autocomplete="username" placeholder="email@exemple.fr" required data-login-demo-target="email">
                <label for="login-password">Mot de passe</label>
                <div class="login-password">
                    <input id="login-password" type="password" autocomplete="current-password" placeholder="Votre mot de passe" required>
                    <button type="button" class="login-password-toggle" aria-controls="login-password" aria-label="Afficher le mot de passe" aria-pressed="false" data-action="login-demo#togglePassword"><i class="bi bi-eye" aria-hidden="true"></i></button>
                </div>
                <button class="login-button">Se connecter</button>
                <a class="mt-3" href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
            </form>
            <p class="login-result" role="status" data-login-demo-target="result"></p>
        </details>
    </main>
{% endblock %}
