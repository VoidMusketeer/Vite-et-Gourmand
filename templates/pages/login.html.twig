{% extends 'base.html.twig' %}
{% block title %}Connexion — Vite & Gourmand{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}
{% block body %}
    <main class="login-page" data-controller="login">
        <header>
            <span>Bienvenue</span>
            <h1>Connectez-vous à votre compte</h1>
            <p>Retrouvez vos commandes et leur suivi.</p>
        </header>
        <form class="login-card" method="post" action="{{ path('app_login') }}" data-turbo="false">
            {% for message in app.flashes('registration_success') %}<p class="login-notice" role="status">{{ message }}</p>{% endfor %}
            {% if error %}<p role="alert">Connexion impossible. Vérifiez votre adresse et votre mot de passe.</p>{% endif %}
            <label for="account-email">Adresse e-mail</label>
            <input id="account-email" name="_username" type="email" autocomplete="username" placeholder="email@exemple.fr" required>
            <label for="account-password">Mot de passe</label>
            <div class="login-password">
                <input id="account-password" name="_password" type="password" autocomplete="current-password" placeholder="Votre mot de passe" required>
                <button type="button" class="login-password-toggle" aria-controls="account-password" aria-label="Afficher le mot de passe" aria-pressed="false" data-action="login#togglePassword"><i class="bi bi-eye" aria-hidden="true"></i></button>
            </div>
            <input name="_csrf_token" type="hidden" value="{{ csrf_token('login_account') }}">
            <button class="login-button">Se connecter</button>
            <a class="login-forgot" href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
            <section class="login-registration" aria-labelledby="login-registration-title">
                <h2 id="login-registration-title">Pas encore de compte ?</h2>
                <p>Créez le vôtre en quelques secondes pour suivre vos demandes.</p>
                <a class="login-button login-create-account" href="{{ path('app_register') }}">Créer mon compte</a>
            </section>
        </form>
    </main>
{% endblock %}
