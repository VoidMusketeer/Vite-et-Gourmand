{% extends 'employee/layout.html.twig' %}{% block heading %}Plats{% endblock %}
{% block content %}<p class="employee-subtitle">Composition des menus et allergènes.</p>{% for dish in dishes %}<article class="employee-card"><div class="employee-row"><div><h2>{{ dish.name }}</h2><p>{{ dish.label }} · {{ dish.uses }} menu(s) associé(s)</p></div><a class="employee-button primary" href="{{ path('employee_dish_edit', {id: dish.id}) }}">Modifier</a></div><details class="employee-delete"><summary>Supprimer ce plat</summary><p>Le plat sera retiré du catalogue. Les menus publiés qui l’utilisent seront dépubliés jusqu’à son remplacement. Les associations historiques sont conservées.</p><form method="post" action="{{ path('employee_dish_delete', {id: dish.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_dish' ~ dish.id) }}"><label class="employee-check"><input type="checkbox" name="confirmed" value="1" required>Confirmer le retrait du plat et la dépublication des menus concernés</label><button class="employee-button danger">Supprimer le plat</button></form></details></article>{% else %}<p class="employee-empty">Aucun plat actif.</p>{% endfor %}{% endblock %}
