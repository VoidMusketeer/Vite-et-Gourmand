<article class="employee-card order-card"><div class="employee-row order-card-header"><div class="order-card-identity"><h3><a href="{{ path('employee_order', {id: order.id}) }}"><span class="order-card-reference">#{{ order.reference }}</span><span class="order-card-separator"> · </span><span class="order-card-menu">{{ order.menu_title ?: 'Menu non renseigné' }}</span></a></h3><p>{{ order.first_name }} {{ order.last_name }} · {{ order.people_count ?? '—' }} personnes</p></div><span class="employee-badge" data-status="{{ order.status }}">{{ statuses[order.status] ?? order.status }}</span></div>
    <div class="employee-row order-card-footer"><p><strong>{{ order.service_date|date('d/m/Y') }} · {{ order.delivery_time|slice(0, 5) }}</strong><br>Livraison · {{ order.delivery_city }}</p><a class="employee-button" href="{{ path('employee_order', {id: order.id}) }}">Voir la commande →</a></div></article>
