{% extends 'employee/layout.html.twig' %}
{% block heading %}Bonjour {{ app.user.firstName }}{% endblock %}
{% block content %}
    <p class="employee-subtitle">{{ today|date('d/m/Y') }} · {{ app.user.staffSchedule ?: 'Horaires à préciser avec votre responsable' }}</p>
    <div class="employee-metrics"><article><span>Commandes du jour en cours</span><strong>{{ orders|length }}</strong></article><article><span>Personnes à servir</span><strong>{{ portions }}</strong></article><article><span>{{ position.department|default('Équipe') == 'Logistique' ? 'Mes contrôles du jour' : 'Mon équipe' }}</span><strong>{{ position.department|default('Équipe') == 'Logistique' ? checked|length ~ ' / 3' : position.department|default('—') }}</strong></article></div>
    {% if next %}<section class="employee-card employee-focus"><p class="eyebrow">PROCHAINE LIVRAISON DE L’ÉQUIPE</p><div class="employee-row"><div><h2>#{{ next.reference }} · {{ next.delivery_time|slice(0, 5) }}</h2><p>{{ next.menu_title }} · {{ next.delivery_city }}</p><span class="employee-badge">{{ statuses[next.status] }}</span></div><a class="employee-button primary" href="{{ path('employee_order', {id: next.id}) }}">Consulter la commande</a></div></section>{% endif %}
    {% if is_granted('ROLE_ADMIN') or position.department|default('') == 'Logistique' %}
        <section class="employee-card"><h2>Mes contrôles du jour</h2><p>À vérifier avant votre premier départ. Ces contrôles sont enregistrés sur votre compte.</p><form action="{{ path('employee_checks') }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('checks') }}">{% for code, label in checks %}<label class="employee-check"><input type="checkbox" name="checks[]" value="{{ code }}" {% if code in checked %}checked{% endif %}>{{ label }}</label>{% endfor %}<button class="employee-button primary">Enregistrer les contrôles</button></form></section>
    {% elseif position.responsibilities|default('') %}<section class="employee-card"><h2>Mon rôle aujourd’hui</h2><p>{{ position.responsibilities }}</p><p class="employee-muted">{{ position.service_context }}</p></section>{% endif %}
    <div class="employee-row section-heading"><h2>Commandes de l’équipe aujourd’hui</h2><a href="{{ path('employee_orders') }}">Toutes les commandes →</a></div><p class="employee-muted">Vue partagée de l’équipe : les commandes ne sont pas affectées individuellement.</p>
    {% for order in orders %}{% include 'employee/_card.html.twig' %}{% else %}<section class="employee-empty"><h2>Aucune commande en cours aujourd’hui</h2><p>Les commandes enregistrées apparaîtront ici à leur date de service.</p><a class="employee-button" href="{{ path('employee_schedule') }}">Consulter le planning</a></section>{% endfor %}
{% endblock %}
