{% extends 'employee/layout.html.twig' %}
{% block heading %}Mon compte{% endblock %}
{% block content %}<p class="employee-subtitle">Vos coordonnées et vos informations de travail.</p>
    <section class="employee-card"><h2>Informations personnelles</h2><form method="post" class="employee-form"><input type="hidden" name="_token" value="{{ csrf_token('employee_account') }}"><input type="hidden" name="action" value="profile"><label>Prénom<input name="first" value="{{ values.first }}" autocomplete="given-name" maxlength="100" required></label><label>Nom<input name="last" value="{{ values.last }}" autocomplete="family-name" maxlength="100" required></label><label>E-mail<input type="email" name="email" value="{{ values.email }}" autocomplete="email" maxlength="254" required></label><label>Téléphone<input type="tel" name="phone" value="{{ values.phone }}" autocomplete="tel" maxlength="30"></label><label class="full">Mot de passe actuel <small>Nécessaire uniquement pour changer votre adresse e-mail.</small><input type="password" name="current_password" autocomplete="current-password"></label><div class="full"><button class="employee-button primary">Enregistrer mes coordonnées</button></div></form></section>
    <section class="employee-card"><h2>Sécurité</h2><details><summary>Changer mon mot de passe</summary><form method="post" class="employee-form"><input type="hidden" name="_token" value="{{ csrf_token('employee_account') }}"><input type="hidden" name="action" value="password"><label class="full">Mot de passe actuel<input type="password" name="current_password" autocomplete="current-password" required></label><label>Nouveau mot de passe<input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="72" required></label><label>Confirmer le mot de passe<input type="password" name="confirmation" autocomplete="new-password" minlength="12" maxlength="72" required></label><p class="full employee-muted">12 à 72 octets. Les caractères accentués peuvent compter pour plusieurs octets.</p><div class="full"><button class="employee-button primary">Enregistrer le mot de passe</button></div></form></details></section>
    <section class="employee-card"><h2>Informations de travail</h2><p class="employee-muted">Gérées par votre responsable. Contactez-le pour toute modification.</p><dl class="employee-details"><div><dt>Poste</dt><dd>{{ app.user.staffFunction ?: 'Non renseigné' }}</dd></div><div><dt>Horaires de service</dt><dd>{{ app.user.staffSchedule ?: 'Non renseignés' }}</dd></div><div><dt>Équipe</dt><dd>{{ position.department|default('Non renseignée') }}</dd></div><div><dt>Responsabilités</dt><dd>{{ position.responsibilities|default('Non renseignées') }}</dd></div></dl></section>
{% endblock %}
