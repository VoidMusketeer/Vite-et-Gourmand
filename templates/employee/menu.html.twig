{% extends 'employee/layout.html.twig' %}{% block heading %}Modifier le menu{% endblock %}
{% block content %}<p><a href="{{ path('employee_menus') }}">← Menus</a></p><form class="employee-card employee-form" method="post"><input type="hidden" name="_token" value="{{ csrf_token('employee_menu' ~ menu.id) }}"><label class="full">Nom<input name="title" maxlength="160" required value="{{ menu.title }}"></label><label class="full">Description<textarea name="description" maxlength="5000" rows="4" required>{{ menu.description }}</textarea></label><label>Minimum de personnes<input name="minimum_people" type="number" min="1" max="9999" required value="{{ menu.minimum_people }}"></label><label>Prix total pour ce minimum (€)<input name="minimum_price" type="number" min="0" max="99999999.99" step="0.01" required value="{{ menu.minimum_price }}"></label><label>Disponible du<input type="date" name="start_date" value="{{ menu.start_date }}"></label><label>Disponible jusqu’au<input type="date" name="end_date" value="{{ menu.end_date }}"></label><label class="full">Conditions<textarea name="conditions" maxlength="5000" rows="3">{{ menu.conditions }}</textarea></label>
<fieldset class="full"><legend>Plats du menu</legend><p class="employee-muted">La sélection conserve les plats et leurs allergènes. Les options existantes restent associées.</p>{% for dish in dishes %}<label class="employee-check"><input type="checkbox" name="dishes[]" value="{{ dish.id }}" {% if dish.id in selected %}checked{% endif %}>{{ dish.label }} · {{ dish.name }}</label>{% endfor %}</fieldset><label>Publication<select name="publication_status">{% for key,label in {'draft':'Brouillon','published':'Publié','unpublished':'Non publié'} %}<option value="{{ key }}" {% if menu.publication_status == key %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><div class="full"><button class="employee-button primary">Enregistrer le menu</button></div></form>{% endblock %}
