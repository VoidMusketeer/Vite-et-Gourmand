{% if order.equipment_loaned or notification %}<section class="employee-card"><h2>Matériel prêté</h2>
{% if order.equipment_loaned %}<p>{{ order.equipment_description }}</p>{% if order.equipment_return_due %}<p>À restituer avant le <strong>{{ order.equipment_return_due|date('d/m/Y') }} inclus</strong> · délai de 10 jours ouvrés. Frais prévus en cas de non-restitution : 600 €.</p>{% endif %}{% if order.equipment_returned_at %}<p>Restitution confirmée le {{ order.equipment_returned_at|date('d/m/Y à H:i','Europe/Paris') }}.</p>{% endif %}{% else %}<p>Aucun prêt de matériel déclaré.</p>{% endif %}
{% if notification %}{% if notification.sent_at %}<p role="status">Notification envoyée au transport mail le {{ notification.sent_at|date('d/m/Y à H:i','Europe/Paris') }}.</p>{% else %}<p role="alert">Notification non envoyée : {{ notification.last_error ?: 'En attente d’envoi.' }}</p><form method="post" action="{{ path('employee_order_notify',{id:order.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('notify' ~ order.id) }}"><button class="employee-button">Relancer la notification</button></form>{% endif %}{% endif %}</section>{% else %}<p class="order-empty-line"><strong>Matériel :</strong> aucun prêt déclaré.</p>{% endif %}
{% if order.status in ['pending','accepted','in_preparation'] %}
<details class="employee-card order-disclosure"><summary>Modifier ou annuler</summary><div class="order-disclosure-content"><p>Contactez d’abord le client par téléphone ou e-mail, puis renseignez l’échange réalisé. Les changements et leur motif seront conservés dans l’historique.</p><div class="employee-actions">{% if order.phone %}<a class="employee-button" href="tel:{{ order.phone|replace({' ':''}) }}">Appeler le client</a>{% endif %}<a class="employee-button" href="mailto:{{ order.email|url_encode }}">Écrire au client</a></div>
<form method="post" action="{{ path('employee_order_change',{id:order.id}) }}" class="employee-form"><input type="hidden" name="_token" value="{{ csrf_token('change' ~ order.id) }}"><input type="hidden" name="version" value="{{ order.updated_at }}">
<label>Mode de contact<select name="contact_method" required><option value="">Choisir</option><option value="phone">Appel GSM</option><option value="email">E-mail</option></select></label><label>Date et heure du contact<input name="contacted_at" type="datetime-local" max="{{ contactNow }}" required></label>
<label class="full">Motif de modification ou d’annulation<textarea name="reason" maxlength="5000" required rows="3"></textarea></label><label class="employee-check full"><input type="checkbox" name="contact_confirmed" value="1" required>Je confirme avoir effectivement contacté le client avant cette action.</label>
<label>Date de service<input type="date" name="service_date" value="{{ order.service_date }}" required></label><label>Heure de livraison<input type="time" name="delivery_time" value="{{ order.delivery_time|slice(0,5) }}" required></label><label class="full">Adresse<input name="delivery_address_line1" value="{{ order.delivery_address_line1 }}" maxlength="255" required></label><label>Code postal<input name="delivery_postal_code" value="{{ order.delivery_postal_code }}" maxlength="20" required></label><label>Ville<input name="delivery_city" value="{{ order.delivery_city }}" maxlength="120" required></label>
<label class="full">Instructions du client<textarea name="customer_note" maxlength="5000" rows="3">{{ order.customer_note }}</textarea></label><label class="employee-check full"><input type="checkbox" name="equipment_loaned" value="1" {% if order.equipment_loaned %}checked{% endif %}>Du matériel est prêté au client</label><label class="full">Matériel prêté (obligatoire en cas de prêt)<textarea name="equipment_description" maxlength="2000">{{ order.equipment_description }}</textarea></label><div class="employee-actions full"><button class="employee-button primary" name="action" value="edit">Enregistrer les modifications</button><button class="employee-button danger" name="action" value="cancel">Annuler la commande avec ce motif</button></div></form></div></details>
{% endif %}
<details class="employee-card order-disclosure"><summary>Contacts et modifications <span>{{ contacts|length }}</span></summary><div class="order-disclosure-content">{% for contact in contacts %}<div class="employee-dish"><strong>{{ contact.action == 'cancel' ? 'Annulation' : 'Modification' }} · {{ contact.contact_method == 'phone' ? 'Appel GSM' : 'E-mail' }}</strong><p>Contact le {{ contact.contacted_at|date('d/m/Y à H:i','Europe/Paris') }} · enregistré par {{ contact.first_name }} {{ contact.last_name }}</p><p>{{ contact.reason }}</p></div>{% else %}<p>Aucun contact préalable enregistré.</p>{% endfor %}</div></details>
