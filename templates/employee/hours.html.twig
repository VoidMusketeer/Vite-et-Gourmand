{% extends 'employee/layout.html.twig' %}{% block heading %}Horaires d’ouverture{% endblock %}
{% block content %}<p class="employee-subtitle">Horaires de l’entreprise affichés sur le site public. Les horaires personnels restent gérés par le responsable.</p>{% for day, label in {1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi', 7: 'Dimanche'} %}{% set hour = hours[day] ?? null %}<article class="employee-card"><h2>{{ label }}</h2>{% if not hour %}<p class="employee-muted">Aucun horaire renseigné.</p>{% endif %}<form method="post" class="employee-form"><input type="hidden" name="_token" value="{{ csrf_token('employee_hours') }}"><input type="hidden" name="day" value="{{ day }}"><label>Ouverture<input type="time" name="opens_at" value="{{ hour.opens_at|default('')|slice(0, 5) }}"></label><label>Fermeture<input type="time" name="closes_at" value="{{ hour.closes_at|default('')|slice(0, 5) }}"></label><label class="employee-check full"><input type="checkbox" name="closed" value="1" {% if hour.is_closed|default(false) %}checked{% endif %}>Fermé ce jour</label><div class="employee-actions full"><button class="employee-button primary" name="action" value="save">Enregistrer</button>{% if hour %}<button class="employee-button danger" name="action" value="delete">Supprimer cet horaire</button>{% endif %}</div></form></article>{% endfor %}{% endblock %}
