{% extends 'employee/layout.html.twig' %}{% block heading %}Modifier le plat{% endblock %}
{% block content %}<p><a href="{{ path('employee_dishes') }}">← Plats</a></p><form class="employee-card employee-form" method="post"><input type="hidden" name="_token" value="{{ csrf_token('employee_dish' ~ dish.id) }}"><label>Nom<input name="name" maxlength="160" required value="{{ dish.name }}"></label><label>Type<select name="dish_type_id">{% for type in types %}<option value="{{ type.id }}" {% if type.id == dish.dish_type_id %}selected{% endif %}>{{ type.label }}</option>{% endfor %}</select></label><label class="full">Description<textarea name="description" maxlength="5000" rows="3">{{ dish.description }}</textarea></label><fieldset class="full"><legend>Allergènes présents</legend><p>Vérifiez la liste complète avant d’enregistrer. Une liste vide enregistrée signifie qu’aucun allergène n’est déclaré pour ce plat.</p>{% for allergen in allergens %}<label class="employee-check"><input type="checkbox" name="allergens[]" value="{{ allergen.id }}" {% if allergen.id in selected %}checked{% endif %}>{{ allergen.name }}</label>{% endfor %}</fieldset><p class="employee-muted full">Ces modifications s’appliquent à tous les menus utilisant ce plat.</p><div class="full"><button class="employee-button primary">Enregistrer le plat</button></div></form>{% endblock %}
