{% extends 'employee/layout.html.twig' %}
{% block heading %}Commande #{{ order.reference }}{% endblock %}
{% block content %}<div class="employee-order-detail"><p class="order-back"><a href="{{ path('employee_orders') }}">← Retour aux commandes</a></p>
<section class="employee-card order-overview"><div class="employee-row"><h2>{{ order.menu_title ?: 'Menu non renseigné' }}</h2><span class="employee-badge" data-status="{{ order.status }}">{{ statuses[order.status] }}</span></div><p>{{ order.people_count ?? '—' }} personnes · {{ order.first_name }} {{ order.last_name }}</p><dl class="employee-details"><div><dt>Livraison prévue</dt><dd>{{ order.service_date|date('d/m/Y') }} à {{ order.delivery_time|slice(0,5) }}</dd></div><div><dt>Adresse</dt><dd>{{ order.delivery_address_line1 }}{% if order.delivery_address_line2 %}<br>{{ order.delivery_address_line2 }}{% endif %}<br>{{ order.delivery_postal_code }} {{ order.delivery_city }}</dd></div></dl><div class="employee-actions"><a class="employee-button" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/dir/?api=1&destination={{ (order.delivery_address_line1 ~ ', ' ~ order.delivery_postal_code ~ ' ' ~ order.delivery_city)|url_encode }}">Itinéraire ↗</a>{% if order.phone %}<a class="employee-button" href="tel:{{ order.phone|replace({' ': '', '.': '', '-': '', '(': '', ')': ''}) }}">Appeler le client</a>{% else %}<span class="employee-muted">Téléphone non renseigné</span>{% endif %}</div></section>
<section class="employee-card"><h2>Instructions du client</h2><p class="employee-note">{{ order.customer_note ?: 'Aucune instruction enregistrée.' }}</p></section>
<section class="employee-card"><h2>Plats et allergènes</h2>{% if legacyAllergens %}<p>Allergènes du menu : {{ legacyAllergens|join(', ') }}. Vérifiez leur répartition avec la cuisine.</p>{% endif %}<p class="employee-muted">Composition du catalogue : confirmez les adaptations avec la cuisine.</p>{% for dish in dishes %}<div class="employee-dish"><strong>{{ dish.name }}{% if dish.is_optional %} · Option du catalogue, sélection à vérifier{% endif %}</strong><p>{{ dish.allergens ?: (dish.allergens_reviewed ? 'Aucun allergène déclaré.' : 'Allergènes à confirmer en cuisine.') }}</p></div>{% else %}<p>Composition non renseignée. Vérifiez avec la cuisine.</p>{% endfor %}</section>
{% if action %}<section class="employee-card employee-focus"><h2>Prochaine étape</h2><form action="{{ path('employee_order_status',{id:order.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('status' ~ order.id) }}"><input type="hidden" name="expected" value="{{ order.status }}"><input type="hidden" name="target" value="{{ action[0] }}"><label class="employee-check"><input type="checkbox" name="confirmed" value="1" required>Je confirme que cette étape est réalisée et que les vérifications nécessaires sont terminées.</label><button class="employee-button primary">{{ action[1] }}</button></form></section>{% endif %}
{% include 'employee/_order_management.html.twig' %}
<details class="employee-card order-disclosure"><summary>Historique <span>{{ history|length }} étapes</span></summary><div class="order-disclosure-content">{% for entry in history %}<div class="employee-dish"><strong>{{ statuses[entry.code] ?? entry.code }}</strong><p>{{ entry.created_at|date('d/m/Y à H:i','Europe/Paris') }}{% if entry.first_name %} · {{ entry.first_name }} {{ entry.last_name }}{% endif %}</p>{% if entry.public_comment %}<p>{{ entry.public_comment }}</p>{% endif %}</div>{% else %}<p>Aucun changement de statut enregistré.</p>{% endfor %}</div></details>
</div>
{% endblock %}
