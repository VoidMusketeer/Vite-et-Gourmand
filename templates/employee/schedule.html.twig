{% extends 'employee/layout.html.twig' %}
{% block heading %}Emploi du temps{% endblock %}
{% block content %}<p class="employee-subtitle">Mes horaires : {{ app.user.staffSchedule ?: 'non renseignés' }}</p><p class="employee-muted">Livraisons de l’équipe aux horaires enregistrés. Ce planning ne constitue pas une affectation personnelle.</p>
<div class="employee-row"><a href="{{ path('employee_schedule',{date:previous}) }}">← Semaine précédente</a><a href="{{ path('employee_schedule') }}">Aujourd’hui</a><a href="{{ path('employee_schedule',{date:following}) }}">Semaine suivante →</a></div>
<nav class="employee-days" aria-label="Jour du planning">{% for day in days %}<a href="{{ path('employee_schedule',{date:day.date}) }}" {% if day.date == date %}aria-current="date"{% endif %}>{{ day.label }}<strong>{{ day.date|date('d/m') }}</strong>{% if day.date == today %}<small>Aujourd’hui</small>{% endif %}</a>{% endfor %}</nav>
<h2 class="section-heading">Livraisons du {{ date|date('d/m/Y') }}</h2>
{% for order in orders %}<article class="employee-card employee-agenda"><strong>{{ order.delivery_time|slice(0,5) }}<small>Livraison prévue</small></strong><div><h3><a href="{{ path('employee_order',{id:order.id}) }}">#{{ order.reference }} · {{ order.menu_title ?: 'Commande' }}</a></h3><p>{{ order.delivery_address_line1 }}, {{ order.delivery_postal_code }} {{ order.delivery_city }}</p><span class="employee-badge">{{ statuses[order.status] }}</span></div></article>{% else %}<section class="employee-empty"><h2>Aucune livraison prévue</h2><p>Aucune commande n’est enregistrée pour cette journée.</p></section>{% endfor %}
{% endblock %}
