{% extends 'employee/layout.html.twig' %}{% block heading %}Avis clients{% endblock %}
{% block content %}<p class="employee-subtitle">Validez les avis à afficher sur l’accueil ou refusez leur publication.</p>{% for review in reviews %}<article class="employee-card"><div class="employee-row"><h2>{{ review.first_name }} · {{ review.rating }}/5</h2><span class="employee-badge">{{ {'pending': 'En attente', 'approved': 'Publié', 'rejected': 'Refusé'} [review.moderation_status] }}</span></div><p>{{ review.reference }} · {{ review.created_at|date('d/m/Y', 'Europe/Paris') }}</p><p class="employee-note">{{ review.comment }}</p><form method="post" action="{{ path('employee_review_moderate', {id: review.id}) }}" class="employee-actions"><input type="hidden" name="_token" value="{{ csrf_token('employee_review' ~ review.id) }}">{% if review.moderation_status != 'approved' %}<button class="employee-button primary" name="state" value="approved">Valider et publier</button>{% endif %}{% if review.moderation_status != 'rejected' %}<button class="employee-button danger" name="state" value="rejected">Refuser</button>{% endif %}</form></article>{% else %}<p class="employee-empty">Aucun avis reçu pour le moment.</p>{% endfor %}{% endblock %}
