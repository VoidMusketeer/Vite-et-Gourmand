{% extends 'employee/layout.html.twig' %}{% block heading %}Menus{% endblock %}
{% block content %}<p class="employee-subtitle">Modifier les menus ou les retirer du catalogue public.</p>{% for menu in menus %}<article class="employee-card"><div class="employee-row"><div><h2>{{ menu.title }}</h2><p>{{ menu.minimum_people }} personnes minimum · {{ menu.minimum_price|number_format(2,',',' ') }} € au minimum</p><span class="employee-badge">{{ {'published':'Publié','draft':'Brouillon','unpublished':'Non publié'}[menu.publication_status] ?? menu.publication_status }}</span></div><a class="employee-button primary" href="{{ path('employee_menu_edit',{id:menu.id}) }}">Modifier</a></div><details class="employee-delete"><summary>Supprimer du catalogue</summary><p>Le menu sera retiré du site et conservé en archive pour préserver les commandes.</p><form method="post" action="{{ path('employee_menu_delete',{id:menu.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_menu' ~ menu.id) }}"><label class="employee-check"><input type="checkbox" name="confirmed" value="1" required>Confirmer le retrait de ce menu</label><button class="employee-button danger">Supprimer le menu</button></form></details></article>{% else %}<p class="employee-empty">Aucun menu dans le catalogue.</p>{% endfor %}{% endblock %}
