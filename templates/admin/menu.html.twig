{% extends 'admin/layout.html.twig' %}{% block heading %}{{ id ? 'Modifier le menu' : 'Nouveau menu' }}{% endblock %}
{% block content %}<form class="fields card-form" method="post" enctype="multipart/form-data" data-turbo="false">
<input type="hidden" name="_token" value="{{ csrf_token('menu' ~ id) }}">
{% if id %}<input type="hidden" name="original_stock" value="{{ values.original_stock }}">{% endif %}
<label class="wide">Nom du menu<input name="title" required maxlength="160" value="{{ values.title ?? '' }}"></label>
<label class="wide">Description<textarea name="description" required maxlength="5000">{{ values.description ?? '' }}</textarea></label>
<label>Prix par personne (€)<input name="price" type="number" min="0.01" step="0.01" required value="{{ values.price ?? '' }}"></label>
<label>Minimum de personnes<input name="min" type="number" min="1" max="9999" required value="{{ values.min ?? '' }}"></label>
<label>Stock disponible (menus complets pour des groupes)<input name="stock" type="number" min="0" max="1000000" required value="{{ values.stock ?? 0 }}"></label>
<label>Disponible du<input type="date" name="start_date" value="{{ values.start_date ?? '' }}"></label>
<label>Au (inclus)<input type="date" name="end_date" value="{{ values.end_date ?? '' }}"></label>
{% for key,label in {'theme':'Thème','tag':'Régime','starter':'Entrée','main_course':'Plat','dessert':'Dessert'} %}
<label>{{ label }}<input name="{{ key }}" maxlength="160" required value="{{ values[key] ?? '' }}"></label>{% endfor %}
<label>Photo principale (JPG, PNG ou WebP, 5 Mo maximum)<input type="file" accept="image/jpeg,image/png,image/webp" name="photo" {{ id ? '' : 'required' }}></label>
<label class="wide">Conditions de service<textarea name="conditions">{{ values.conditions ?? '' }}</textarea></label>
<div class="wide"><button name="state" value="draft">Enregistrer le brouillon</button> <button class="primary" name="state" value="published">Publier le menu</button> <a href="{{ path('admin_menus') }}">Retour aux menus</a></div></form>{% endblock %}
